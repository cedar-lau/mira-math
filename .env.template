# Copy this file to .env and fill in the API keys for the providers you need.

# OpenAI (gpt-*, default backend for any model name without a prefix)
OPENAI_API_KEY=

# Google Generative AI (gemini-* models)
GOOGLE_API_KEY=

# OpenRouter (openrouter/<model> prefix)
OPENROUTER_API_KEY=

# Local OpenAI-compatible endpoint (local/<model> prefix)
# e.g. vLLM, ollama, llama.cpp server, LM Studio, ...
MIRA_MATH_LOCAL_BASE_URL=http://localhost:8000/v1
MIRA_MATH_LOCAL_API_KEY=not-needed
# Optional: override request timeout (seconds) for the local endpoint
# MIRA_MATH_LOCAL_TIMEOUT=120

# Default models. The TIER_A / TIER_B variables take precedence; if absent,
# we fall back to MODEL_A / MODEL_B and finally to MIRA_MATH_MODEL.
MIRA_MATH_MODEL_TIER_A=gpt-4o
MIRA_MATH_MODEL_TIER_B=gpt-4o-mini
MIRA_MATH_MODEL=gpt-4o-mini
